# Copy to bridge/.env. Generate the token with: openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
# Every calling container must send this value as X-Bridge-Token. Compose refuses
# to start while it is empty, and the bridge refuses placeholders and values
# shorter than 24 characters.
CLAUDE_BRIDGE_TOKEN=

# Optional: a second secret for the routes that see every app (/admin/reload,
# /log/tail). When set, those routes also need X-Admin-Token: <this value>.
# CLAUDE_BRIDGE_ADMIN_TOKEN=

# Claude Code credentials file on the host (created by `claude login`),
# e.g. /home/you/.claude/.credentials.json
CLAUDE_CREDENTIALS_FILE=/path/to/.claude/.credentials.json

# Optional: your own allowlist (defaults to bridge-allowlist.example.json)
# BRIDGE_ALLOWLIST_FILE=./bridge-allowlist.json

# Optional: host port for the bridge (published on 127.0.0.1 only)
# BRIDGE_PORT=7777

# Qdrant for /rag/*. By default the bundled Qdrant starts with the bridge (its
# data in a named volume, no host port). To use a Qdrant already running on the
# host instead, delete the COMPOSE_PROFILES line and set
# QDRANT_URL=http://host.docker.internal:6333
COMPOSE_PROFILES=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Optional: Ollama for EMBED_PROVIDER=ollama and the quota fallback
OLLAMA_URL=
EMBED_PROVIDER=local
