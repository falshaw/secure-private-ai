# Copy to bridge/.env. Generate the token with: openssl rand -hex 32
# Every calling container must send this value as X-Bridge-Token.
CLAUDE_BRIDGE_TOKEN=change-me

# Claude Code credentials file on the host (created by `claude login`),
# e.g. /home/you/.claude/.credentials.json
CLAUDE_CREDENTIALS_FILE=/path/to/.claude/.credentials.json

# Optional: your own allowlist (defaults to bridge-allowlist.example.json)
# BRIDGE_ALLOWLIST_FILE=./bridge-allowlist.json

# Optional: host port for the bridge (published on 127.0.0.1 only)
# BRIDGE_PORT=7777

# Optional: Qdrant for /rag/*. The default is a Qdrant on the HOST's port 6333.
# For the bundled one: `docker compose --profile qdrant up -d` and
# QDRANT_URL=http://qdrant:6333
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=

# Optional: Ollama for EMBED_PROVIDER=ollama and the quota fallback
OLLAMA_URL=
EMBED_PROVIDER=local
